{
  "name": "@ethantang1024/pi-notify",
  "version": "1.0.1",
  "description": "Focus-aware desktop notifications and sounds for Pi coding agent. Fires on task completion, errors, and questions with DECSET 1004 terminal focus tracking and 100% reliable native OS delivery (Windows Shell NotifyIcon, Linux libnotify).",
  "keywords": [
    "pi-package",
    "pi-dev",
    "pi-extension",
    "pi",
    "notify",
    "notification",
    "focus-aware",
    "terminal-focus",
    "decset-1004",
    "sound",
    "desktop",
    "alert"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ethantang1024/pi-notify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethantang1024/pi-notify.git"
  },
  "files": [
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "extensions/index.js",
    "extensions/package.json"
  ],
  "scripts": {
    "test": "node --test extensions/test/*.test.js"
  },
  "pi": {
    "extensions": [
      "./extensions/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
